# Copy to .env. Keep .env private; never commit it.
GEMINI_API_KEY=
# Optional quota/auth fallback keys; comma-separated, keep private, preferably separate projects.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# Optional OpenAI-compatible provider configuration.
AI_PROVIDER=gemini
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# SQLite is the safe local default. Supabase mode is explicit and fail-closed.
DB_BACKEND=sqlite
SUPABASE_DB_URL=
# Required only when DB_BACKEND=supabase; Google OAuth Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must equal PUBLIC_BASE_URL/auth/google/callback.
GOOGLE_REDIRECT_URI=
HOST=0.0.0.0
PORT=8000
HOST_PORT=8000
# Set actual LAN IPv4 before using ESP, e.g. http://192.168.1.20:8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Leave blank to generate random tokens in data/local_tokens.json
WEB_TOKEN=
DEVICE_TOKEN=

# ESP32-S3-WROOM-1 N16R8: 16 MB QIO flash, 8 MB octal PSRAM.
CONFIG_BOARD_TYPE_AI_CHATBOT_S3=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions/v2/16m.csv"
CONFIG_LANGUAGE_VI_VN=y
CONFIG_WAKE_WORD_DISABLED=y
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_USE_DEVICE_AEC=n
CONFIG_USE_SERVER_AEC=n
CONFIG_USE_WECHAT_MESSAGE_STYLE=y
CONFIG_FLASH_DEFAULT_ASSETS=y
# OTA URL and Authorization are supplied by ignored chatbot_local_config.h.
